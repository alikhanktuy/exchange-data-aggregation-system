{
  "Exchanges": [
    { "Name": "ExchangeA", "Url": "ws://localhost:5000/ws/exchangeA" },
    { "Name": "ExchangeB", "Url": "ws://localhost:5000/ws/exchangeB" },
    { "Name": "ExchangeC", "Url": "ws://localhost:5000/ws/exchangeC" }
  ],
  "Pipeline": {
    "BatchSize": 200,
    "FlushIntervalMs": 500,
    "DeduplicationWindowSec": 5,
    "ChannelCapacity": 10000,
    "ReconnectMaxRetries": 5
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Database=ticks_db;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/aggregator.log" } }
    ]
  }
}
